# ─────────────────────────────────────────────────────────────
# BokingYuk Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Salin file ini menjadi .env lalu sesuaikan nilainya.
#
# Development (default):
#   VITE_API_BASE_URL=http://localhost:8000/api
#
# Production (contoh domain):
#   VITE_API_BASE_URL=https://bokingyuk.example.com/api
#
# Pastikan backend berjalan di domain/port yang sama atau
# sudah dikonfigurasi CORS dengan benar.
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000/api
